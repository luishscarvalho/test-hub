# Copie para .env. O docker compose lê este arquivo sozinho.
POSTGRES_USER=testhub
POSTGRES_PASSWORD=testhub
POSTGRES_DB=testhub

# Usadas pelos testes de integração rodando fora do Compose.
DATABASE_URL=postgresql+psycopg://testhub:testhub@localhost:5432/testhub
REDIS_URL=redis://localhost:6379/0

# Troque se a porta já estiver ocupada na sua máquina.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# HUB_PORT=8000
# TARGET_API_PORT=8001

# Liga as respostas erradas da API alvo (ADR-008).
MODO_FALHA=false

# Padrões do hub e do worker (app/bootstrap/configuracao.py). Descomente para trocar.
# SEED=42                        # seed do gerador, registrada em cada run (RN-14)
# LIMITE_DE_CASOS=10             # casos por operação (ADR-005)
# TIMEOUT_REQUISICAO_S=5         # por requisição à API alvo (RN-03)
# TIMEOUT_DOWNLOAD_SPEC_S=5      # download da spec por URL (RN-02)
# TEMPO_MAXIMO_RUN_S=300         # tempo máximo do job; excedido, a run é interrompida (RN-12)
# TIMEOUT_CONEXAO_S=3            # espera pelo Redis no disparo; esgotada, 503 (RN-16)
